{
  "expo": {
    "name": "Pango",
    "slug": "calorie-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#FF5D73"
      },
      "predictiveBackGestureEnabled": false,
      "package": "io.lightarch.pango",
      "blockedPermissions": [
        "android.permission.READ_PHONE_STATE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.health.READ_STEPS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Pango to use the camera to photograph your food and scan barcodes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-iap",
        {
          "android": {
            "store": "play"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#0B0E17"
        }
      ],
      [
        "react-native-fast-tflite",
        {
          "enableAndroidGpuLibraries": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Pango to use the camera to photograph your food.",
          "photosPermission": "Allow Pango to read a food photo you choose.",
          "microphonePermission": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "scheme": "pango",
    "backgroundColor": "#0B0E17",
    "extra": {
      "apiUrl": "https://pango-api-stage.lightarch.io"
    }
  }
}
