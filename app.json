{
  "expo": {
    "name": "Calorie App",
    "slug": "calorie-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.brandonleelast.calorieapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Calorie App to use the camera to photograph your food and scan barcodes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-iap",
        {
          "android": {
            "store": "play"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0B0E17"
        }
      ],
      [
        "react-native-fast-tflite",
        {
          "enableAndroidGpuLibraries": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Calorie App to use the camera to photograph your food.",
          "photosPermission": "Allow Calorie App to read a food photo you choose.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false
          }
        }
      ]
    ],
    "scheme": "calorieapp",
    "backgroundColor": "#0B0E17"
  }
}
