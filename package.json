{
  "name": "calorie-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "expo": "~58.0.14",
    "expo-asset": "~58.0.16",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.9",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-iap": "~6.2.0",
    "expo-image-manipulator": "~58.0.14",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-splash-screen": "~58.0.10",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "fast-png": "^8.0.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-health-connect": "4.1.3",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "^0.13.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/sql.js": "^1.4.11",
    "jest-expo": "~58.0.11",
    "sql.js": "^1.15.1",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "bundle-check": "expo export --platform android",
    "pango:sync": "node scripts/pango-sync.mjs",
    "api:types": "node scripts/api-types.mjs",
    "test:backend": "node scripts/test-backend.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|fast-png|iobuffer))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "setupFiles": [
      "./jest.setup.js"
    ],
    "resolver": "react-native-reanimated/jest/resolver",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.[jt]s?(x)"
    ]
  }
}
